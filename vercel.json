{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/parcelles.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/dvf.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/dvf-around.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/plu.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/parcelles-libres.js": {
      "maxDuration": 60,
      "memory": 1769
    },
    "api/loyers.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/dpe.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/eau.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, immutable" }]
    }
  ]
}
